# OLT padrão IP 10.11.104.2  user: root password:admin123 acesse por ssh ou Mikrotik
system ssh 172.16.10.2 user=root  #acessar a olt via mikrotik

enable
config   # modo privilegiado

#CRIAR DBA
dba-profile add profile-id 101 profile-name 1GIGA type4 max 1024000

#CRIAR LINE PROFILE
ont-lineprofile gpon profile-id 101 profile-name TESTE
tcont 1 dba-profile-id 101
gem add 101 eth tcont 1
gem mapping 101 0 vlan 1001 
commit
quit
  
#CRIAR SERVER PROFILE
ont-srvprofile gpon profile-id 101 profile-name HG8010
ont-port eth adaptive pots adaptive
commit
quit
  
#CRIAR VLAN PARA GERENCIAR
vlan 1100 smart 
interface vlanif 1100
ip address 172.16.10.2 255.255.255.252 #ip de gerenciamento
quit

#CRIAR VLAN DE SERVIÇOS
vlan 101 to 116 smart   #vlan de serviço não precisa de IP
  
#VINCULAR AS VLANS NA PORTA DE UPLINK
port vlan 1100 0/3 0
port vlan 101 to 116 0/3 0

#VALIDAR AS CONFIGURAÇÕES
enable
config
board confirm ?
display board 0
board confirm 0/0
board confirm 0/1
  
#ATIVAR AS POTRAS ONT
port 0 ont-auto-find enable  #ativa a busca automática das onus na porrta 0
port 1 ont-auto-find enable  #ativa a busca automática das onus na porrta 1
display ont autofind all   #mostra a ont encontrada junto com seus parametros 
interface gpon 0/0
ont confirm 0 sn-auth ################ omci ont-lineprofile-id 101 ont-srvprofile-id 101 desc onulab   #no lugar do ##, coloque o sn que aparece no resultado 
#do comando autofind (ont Sn, só os números cerda de 16 números)
#ont add 0 sn-auth "*****************" omci ont-lineprofile-id 101 ont-srvprofile-id 101 desc onu-teste  #talves esse comando necessário testar
ont port native-vlan 0 0 eth 1 vlan 1001
quit
service-port vlan 101 gpon 0/0/0 ont 0 gemport 101 multi-service user-vlan 1001
