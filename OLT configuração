# OLT padrão IP 10.11.104.2  user: root password:admin123 acesse por ssh ou Mikrotik

enable
config   # modo privilegiado

#CRIAR DBA
dba-profile add profile-id 101 profile-name 1GIGA type4 max 1024000

#CRIAR LINE PROFILE
ont-lineprofile gpon profile-id 101 profile-name TESTE
tcont 1 dba-profile-id 101
gem add 101 eth tcont 1
gem mapping 101 0 vlan 1001 
commit
quit
  
#CRIAR SERVER PROFILE
ont-srvprofile gpon profile-id 101 profile-name HG8010
ont-port eth adaptive pots adaptive
commit
quit
  
#CRIAR VLAN PARA GERENCIAR
vlan 1100 smart 
interface vlanif 1100
ip address 172.16.10.2 255.255.255.252 #ip de gerenciamento
quit

#CRIAR VLAN DE SERVIÇOS
vlan 101 to 116 smart   #vlan de serviço não precisa de IP
  
#VINCULAR AS VLANS NA PORTA DE UPLINK
port vlan 1100 0/3 0
port vlan 101 to 116 0/3 0
  
  

  // ADICIONAR IP NA VLAN DE GERENCIA
  
  
  MA5800-X2(config)#
  MA5800-X2(config-if-vlanif1100)#
  
   =======================================================================================================================================

  // ADICIONAR ONT
  
  MA5800-X2(config)#display board 0
  MA5800-X2(config)#board confirm 0/0
  MA5800-X2(config)#board confirm 0/1
  
  =======================================================================================================================================

  // ADICIONAR ONT
  
  MA5800-X2(config)#display ont autofind all
  MA5800-X2(config)#interface gpon 0/3
  MA5800-X2(config-if-gpon-0/3)#ont add 0 sn-auth "*****************" omci ont-lineprofile-id 101 ont-srvprofile-id 101 desc "onu-teste"
  MA5800-X2(config-if-gpon-0/3)#ont port native-vlan 7 23 eth 1 vlan 1001
  MA5800-X2(config-if-gpon-0/3)#quit
  MA5800-X2(config)#service-port vlan 101 gpon 0/0/0 ont 0 gemport 101 multi-service user-vlan 1001
